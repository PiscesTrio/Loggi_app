# Real-device regression captures (screenshots / widget trees). Local evidence,
# not source: they are large, machine-specific, and meaningless outside the run
# that produced them.
.regression/

# Delegated-agent reports: scratch output, not source.
.claude/

# openapi-generator scratch output; the models it produces are copied into
# lib/app/data/api/ and committed, the rest is not.
build/openapi-gen/

# gen-l10n output: generated from lib/l10n/*.arb on every build.
lib/l10n/app_localizations*.dart
